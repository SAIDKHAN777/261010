# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-REST-TOKEN]"

# Privacy IP Hashing (Minimum 32 characters)
IP_HASH_SALT="change-this-to-a-secure-random-secret-at-least-32-chars-long"

# Admin Authentication (HS256 JWT, Minimum 32 characters secret)
ADMIN_JWT_SECRET="change-this-to-a-secure-jwt-secret-at-least-32-chars-long"
ADMIN_JWT_ISSUER="https://api.saidkhan.dev"
ADMIN_JWT_AUDIENCE="https://saidkhan.dev"

# Email Delivery (Resend)
RESEND_API_KEY="re_1234567890abcdef"
EMAIL_FROM="Said Khan Portfolio <notifications@saidkhan.dev>"

# Telegram Notifications
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Google Gemini API
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7

# Persona Configuration
PERSONA_BIO="Said Khan is an AI Solutions Architect and Full-Stack Systems Engineer specializing in high-throughput distributed systems, modern AI architectures, and developer tooling."
PERSONA_PROJECTS_FALLBACK="Said has architected and delivered multiple enterprise AI systems, high-performance web applications, and autonomous agent workflows."
PERSONA_BOOKING_URL="https://cal.com/saidkhan/architecture-consultation"
PERSONA_TONE="Professional, articulate, insightful, and technically precise."

# CORS Allowed Origins (Comma-separated, no wildcards allowed)
ALLOWED_ORIGINS="http://localhost:3000,https://saidkhan.dev,https://www.saidkhan.dev"
